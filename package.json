{
  "name": "mail",
  "version": "0.0.0",
  "private": true,
  "description": "Durable transactional mail for Pegma components.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "clean": "tsc -b --clean",
    "bootstrap:pack": "node scripts/release-packages.mjs bootstrap-pack --output .bootstrap-release",
    "bootstrap:registry": "node scripts/release-packages.mjs bootstrap-registry --manifest .bootstrap-release/package-manifest.json",
    "bootstrap:verify": "node scripts/release-packages.mjs bootstrap-verify --manifest .bootstrap-release/package-manifest.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-packages.mjs check",
    "release:pack": "node scripts/release-packages.mjs pack",
    "release:registry": "node scripts/release-packages.mjs registry",
    "release:publish": "node scripts/release-packages.mjs publish",
    "test": "pnpm run build && vitest run"
  },
  "devDependencies": {
    "@azure/data-tables": "^13.3.1",
    "@pegma/storage-azure-tables": "0.4.0",
    "@types/node": "^26.1.1",
    "azurite": "^3.36.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1"
    }
  }
}
